# Python development snippets
# Created: 2025-12-26

snippet main "Python main function"
def main():
    ${1:pass}

if __name__ == "__main__":
    main()
endsnippet

snippet class "Python class"
class ${1:ClassName}:
    """${2:Docstring}"""

    def __init__(self):
        ${3:pass}
endsnippet

snippet cl "Python class (short)"
class ${1:ClassName}:
    ${2:pass}
endsnippet

snippet def "Python function"
def ${1:function_name}(${2:args}):
    """${3:Docstring}"""
    ${4:pass}
endsnippet

snippet lambda "Python lambda"
lambda ${1:args}: ${2:expression}
endsnippet

snippet try "Python try/except"
try:
    ${1:pass}
except ${2:Exception} as e:
    ${3:print(e)}
endsnippet

snippet with "Python context manager"
with ${1:expression} as ${2:var}:
    ${3:pass}
endsnippet

snippet for "Python for loop"
for ${1:item} in ${2:iterable}:
    ${3:pass}
endsnippet

snippet if "Python if statement"
if ${1:condition}:
    ${2:pass}
endsnippet

snippet imp "Python import"
import ${1:module}
endsnippet

snippet from "Python from import"
from ${1:module} import ${2:name}
endsnippet

snippet logging "Python logging setup"
import logging

logging.basicConfig(level=logging.DEBUG)
logger = logging.getLogger(__name__)

logger.debug("${1:message}")
endsnippet

snippet pytest "Pytest test function"
def test_${1:description}():
    ${2:assert True}
endsnippet

snippet unittest "Python unittest"
import unittest

class ${1:TestClassName}(unittest.TestCase):
    def test_${2:method}(self):
        ${3:pass}

if __name__ == "__main__":
    unittest.main()
endsnippet
